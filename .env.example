# ---- copy to .env and fill in ----

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. In production set to your domain, e.g. nlregex.duckdns.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Public origin of the frontend (for CORS when running vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Fernet key used to encrypt S3 credentials at rest in Redis.
# Generate one:  docker compose run --rm web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_WITH_GENERATED_KEY

# Postgres
POSTGRES_DB=nlregex
POSTGRES_USER=nlregex
POSTGRES_PASSWORD=nlregex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (db 0 = celery broker, 1 = celery results, 2 = app cache/credentials)
REDIS_URL=redis://redis:6379

# LLM via OpenRouter (OpenAI-compatible). Set LLM_PROVIDER=fake to run without a key (email regex only).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CACHE_TTL_SECONDS=604800

# S3 credential session lifetime (seconds)
CONNECTION_TTL_SECONDS=7200
# Optional: custom S3 endpoint (LocalStack for local dev; docker-compose.override.yml sets it). Leave empty for real AWS.
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=ap-northeast-1

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=3g
SPARK_SHUFFLE_PARTITIONS=16
RESULTS_DIR=/data/results

# Celery
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=1900

# Production only (Caddy auto-HTTPS). ACME_EMAIL is optional (Let's Encrypt expiry reminders).
DOMAIN=nlregex-jimmy.duckdns.org
ACME_EMAIL=
